# Server
PORT=5000
NODE_ENV=development
# Set to a positive integer when the API sits behind a reverse proxy, so that
# req.secure and client IPs are derived from X-Forwarded-Proto / X-Forwarded-For.
TRUST_PROXY=0
# PostgreSQL connection string (used by Prisma)
DATABASE_URL=postgresql://linkforge:linkforge@localhost:5432/linkforge

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ACCESS_COOKIE_NAME=linkforge_token
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Public URL used when building short links and QR codes
# Points at the redirect service (the Express server) in development
BASE_URL=http://localhost:5000
APP_URL=http://localhost:5173

# Rate limiting (generic API limits)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Strict per-user limits for link creation
GUEST_LINK_LIMIT_PER_HOUR=10
USER_LINK_LIMIT_PER_HOUR=100

# Guest links expire after this many milliseconds (default 7 days)
GUEST_LINK_TTL_MS=604800000

# Salt used to anonymize visitor IP addresses before storage
ANALYTICS_PEPPER=replace-with-another-random-string

# Plaintext reset links are only returned when NODE_ENV !== production
# and SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinkForge <no-reply@example.com>

# Frontend (Vite) - API origin prefix added to every call.
# Paths already begin with /api, so only set the origin (e.g. https://api.example.com).
# Leave empty to use the Vite dev proxy or the same-origin nginx proxy.
VITE_API_URL=